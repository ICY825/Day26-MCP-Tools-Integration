# Khoá WeatherAPI — đăng ký miễn phí tại https://www.weatherapi.com
# Server đọc biến này từ môi trường, không tự nạp file .env:
#   $env:WEATHERAPI_KEY = "<khoá>"    # PowerShell
#   export WEATHERAPI_KEY="<khoá>"    # bash
WEATHERAPI_KEY=your_weatherapi_key_here

# Tuỳ chọn — đổi cổng, mặc định 8085
# PORT=8085

# Sao chép file này thành .env rồi điền khoá thật.
# Lấy khoá tại: https://aistudio.google.com/apikey
#
# LƯU Ý cho Windows/PowerShell: KHÔNG tạo .env bằng `echo "..." > .env`
# vì lệnh đó ghi kèm BOM và dotenv sẽ không đọc được tên biến.
# Dùng cách này thay thế:
#   [System.IO.File]::WriteAllText("$PWD\.env", "GOOGLE_API_KEY=<khoá>`n", (New-Object System.Text.UTF8Encoding($false)))
GOOGLE_API_KEY=your_gemini_api_key_here
